# Copy to .env and fill in. Never commit the resulting file.
# Use the same hex-only password in POSTGRES_PASSWORD and DATABASE_URL.
# Hex avoids URL-reserved characters; generate it with: openssl rand -hex 32
DATABASE_URL=postgresql+psycopg://stockapp:change-me@db:5432/stockanalyzer
APP_ENV=production
AUTH_SESSION_MINUTES=60
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15
POSTGRES_DB=stockanalyzer
POSTGRES_USER=stockapp
POSTGRES_PASSWORD=change-me

# Twelve Data (OHLCV, 800 calls/day free): https://twelvedata.com/
TWELVEDATA_KEY=
# Finnhub (fundamentals + analyst + news, 60 calls/min free): https://finnhub.io/
# Without this key the app runs technicals-only (no fundamentals/analyst/news).
FINNHUB_KEY=
